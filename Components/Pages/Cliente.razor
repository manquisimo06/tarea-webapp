@page "/cliente"

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations

@rendermode InteractiveServer

@inject HttpClient Http

<PageTitle>Clientes</PageTitle>

<div class="container mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Clientes</h2>

        <button class="btn btn-primary"
                @onclick="NuevoCliente">
            + Nuevo
        </button>

    </div>


    <!-- MENSAJES -->
    @if (!string.IsNullOrEmpty(Mensaje))
    {
        <div class="alert @(EsError ? "alert-danger" : "alert-success")">
            @Mensaje
        </div>
    }


    <!-- CARGANDO -->
    @if (Cargando)
    {
        <div class="text-center mt-4">
            <div class="spinner-border" role="status">
            </div>

            <p class="mt-2">
                Cargando clientes...
            </p>
        </div>
    }
    else
    {

        <!-- TABLA -->
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>CUI</th>
                        <th>NIT</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Fecha nacimiento</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @if (ClientesPagina.Any())
                    {

                        @foreach (var cliente in ClientesPagina)
                        {
                            <tr>

                                <td>
                                    @cliente.CUI
                                </td>

                                <td>
                                    @cliente.NIT
                                </td>

                                <td>
                                    @cliente.Nombres
                                </td>

                                <td>
                                    @cliente.Apellidos
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(cliente.Direccion)
                                        ? "-"
                                        : cliente.Direccion)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(cliente.Telefono)
                                        ? "-"
                                        : cliente.Telefono)
                                </td>

                                <td>
                                    @cliente.Fecha_Nacimiento.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <button class="btn btn-warning btn-sm me-2"
                                            @onclick="() => EditarCliente(cliente)">
                                        Editar
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => ConfirmarEliminar(cliente)">
                                        Eliminar
                                    </button>

                                </td>

                            </tr>
                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="8"
                                class="text-center">

                                No existen clientes registrados.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>


        <!-- PAGINACIÓN -->
        @if (TotalPaginas > 1)
        {
            <div class="d-flex justify-content-center align-items-center mt-3">

                <button class="btn btn-secondary me-2"
                        disabled="@(PaginaActual == 1)"
                        @onclick="PaginaAnterior">
                    Anterior
                </button>

                <span class="mx-3">
                    Página @PaginaActual de @TotalPaginas
                </span>

                <button class="btn btn-secondary"
                        disabled="@(PaginaActual == TotalPaginas)"
                        @onclick="PaginaSiguiente">
                    Siguiente
                </button>

            </div>
        }

    }

</div>


<!-- ===================================================== -->
<!-- MODAL NUEVO / EDITAR -->
<!-- ===================================================== -->

@if (MostrarModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-lg">

            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">

                    <h5 class="modal-title">
                        @(ModoEdicion ? "Editar Cliente" : "Nuevo Cliente")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarModal">
                    </button>

                </div>


                <!-- FORMULARIO -->
                <EditForm Model="ClienteFormulario"
                          OnValidSubmit="GuardarCliente">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <ValidationSummary />


                        <!-- CUI -->
                        <div class="mb-3">

                            <label class="form-label">
                                CUI
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="ClienteFormulario.CUI" />

                            <ValidationMessage For="@(() => ClienteFormulario.CUI)" />

                        </div>


                        <!-- NIT -->
                        <div class="mb-3">

                            <label class="form-label">
                                NIT
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="ClienteFormulario.NIT" />

                            <ValidationMessage For="@(() => ClienteFormulario.NIT)" />

                        </div>


                        <!-- NOMBRES -->
                        <div class="mb-3">

                            <label class="form-label">
                                Nombres
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="ClienteFormulario.Nombres" />

                            <ValidationMessage For="@(() => ClienteFormulario.Nombres)" />

                        </div>


                        <!-- APELLIDOS -->
                        <div class="mb-3">

                            <label class="form-label">
                                Apellidos
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="ClienteFormulario.Apellidos" />

                            <ValidationMessage For="@(() => ClienteFormulario.Apellidos)" />

                        </div>


                        <!-- DIRECCIÓN -->
                        <div class="mb-3">

                            <label class="form-label">
                                Dirección
                            </label>

                            <InputTextArea class="form-control"
                                           @bind-Value="ClienteFormulario.Direccion" />

                        </div>


                        <!-- TELÉFONO -->
                        <div class="mb-3">

                            <label class="form-label">
                                Teléfono
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="ClienteFormulario.Telefono" />

                        </div>


                        <!-- FECHA NACIMIENTO -->
                        <div class="mb-3">

                            <label class="form-label">
                                Fecha de nacimiento
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="ClienteFormulario.Fecha_Nacimiento" />

                            <ValidationMessage For="@(() => ClienteFormulario.Fecha_Nacimiento)" />

                        </div>

                    </div>


                    <!-- FOOTER -->
                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CerrarModal">

                            Cancelar

                        </button>


                        @if (Guardando)
                        {

                            <button type="button"
                                    class="btn btn-primary"
                                    disabled>

                                Guardando...

                            </button>

                        }
                        else
                        {

                            <button type="submit"
                                    class="btn btn-primary">

                                @(ModoEdicion ? "Actualizar" : "Guardar")

                            </button>

                        }

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}


<!-- ===================================================== -->
<!-- MODAL CONFIRMAR ELIMINACIÓN -->
<!-- ===================================================== -->

@if (MostrarConfirmacion)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Confirmar eliminación
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CancelarEliminar">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        ¿Está seguro que desea eliminar al cliente
                        <strong>
                            @ClienteEliminar?.Nombres
                            @ClienteEliminar?.Apellidos
                        </strong>
                        ?
                    </p>

                    <p class="text-danger">
                        Esta acción no se puede deshacer.
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelarEliminar">

                        No

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="EliminarCliente">

                        Sí, eliminar

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {

    // =====================================================
    // VARIABLES
    // =====================================================

    private List<ClienteDto> Clientes = new();

    private ClienteDto ClienteFormulario = new();

    private ClienteDto? ClienteEliminar;


    private bool MostrarModal = false;

    private bool MostrarConfirmacion = false;

    private bool ModoEdicion = false;

    private bool Cargando = false;

    private bool Guardando = false;


    private string Mensaje = "";

    private bool EsError = false;


    // =====================================================
    // PAGINACIÓN
    // =====================================================

    private int PaginaActual = 1;

    private int RegistrosPorPagina = 10;


    private int TotalPaginas
    {
        get
        {
            if (Clientes.Count == 0)
                return 1;

            return (int)Math.Ceiling(
                Clientes.Count / (double)RegistrosPorPagina
            );
        }
    }


    private IEnumerable<ClienteDto> ClientesPagina
    {
        get
        {
            return Clientes
                .Skip((PaginaActual - 1) * RegistrosPorPagina)
                .Take(RegistrosPorPagina);
        }
    }


    // =====================================================
    // AL CARGAR LA PÁGINA
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }


    // =====================================================
    // GET
    // =====================================================

    private async Task CargarClientes()
    {
        try
        {
            Cargando = true;

            Mensaje = "";

            var resultado =
                await Http.GetFromJsonAsync<List<ClienteDto>>(
                    "api/Clientes"
                );

            Clientes = resultado ?? new List<ClienteDto>();

            PaginaActual = 1;
        }
        catch (Exception ex)
        {
            EsError = true;

            Mensaje =
                "Error al cargar los clientes: " + ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }


    // =====================================================
    // NUEVO
    // =====================================================

    private void NuevoCliente()
    {
        ModoEdicion = false;

        ClienteFormulario = new ClienteDto
        {
            Fecha_Nacimiento = DateTime.Today
        };

        Mensaje = "";

        MostrarModal = true;
    }


    // =====================================================
    // EDITAR
    // =====================================================

    private void EditarCliente(ClienteDto cliente)
    {
        ModoEdicion = true;

        ClienteFormulario = new ClienteDto
        {
            Id_cliente = cliente.Id_cliente,
            CUI = cliente.CUI,
            NIT = cliente.NIT,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Fecha_Nacimiento = cliente.Fecha_Nacimiento
        };

        Mensaje = "";

        MostrarModal = true;
    }


    // =====================================================
    // GUARDAR / ACTUALIZAR
    // =====================================================

    private async Task GuardarCliente()
    {
        try
        {
            Guardando = true;

            Mensaje = "";


            if (ModoEdicion)
            {
                // =========================================
                // PUT
                // =========================================

                var respuesta =
                    await Http.PutAsJsonAsync(
                        $"api/Clientes/{ClienteFormulario.Id_cliente}",
                        ClienteFormulario
                    );


                if (respuesta.IsSuccessStatusCode)
                {
                    MostrarModal = false;

                    Mensaje =
                        "Cliente actualizado correctamente.";

                    EsError = false;

                    await CargarClientes();
                }
                else
                {
                    EsError = true;

                    Mensaje =
                        $"Error al actualizar el cliente. Código: {(int)respuesta.StatusCode}";
                }

            }
            else
            {
                // =========================================
                // POST
                // =========================================

                var respuesta =
                    await Http.PostAsJsonAsync(
                        "api/Clientes",
                        ClienteFormulario
                    );


                if (respuesta.IsSuccessStatusCode)
                {
                    MostrarModal = false;

                    Mensaje =
                        "Cliente guardado correctamente.";

                    EsError = false;

                    await CargarClientes();
                }
                else
                {
                    EsError = true;

                    Mensaje =
                        $"Error al guardar el cliente. Código: {(int)respuesta.StatusCode}";
                }
            }

        }
        catch (Exception ex)
        {
            EsError = true;

            Mensaje =
                "Error al comunicarse con la API: " + ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }


    // =====================================================
    // CERRAR MODAL
    // =====================================================

    private void CerrarModal()
    {
        MostrarModal = false;
    }


    // =====================================================
    // CONFIRMAR ELIMINACIÓN
    // =====================================================

    private void ConfirmarEliminar(ClienteDto cliente)
    {
        ClienteEliminar = cliente;

        MostrarConfirmacion = true;
    }


    // =====================================================
    // CANCELAR ELIMINACIÓN
    // =====================================================

    private void CancelarEliminar()
    {
        MostrarConfirmacion = false;

        ClienteEliminar = null;
    }


    // =====================================================
    // DELETE
    // =====================================================

    private async Task EliminarCliente()
    {
        if (ClienteEliminar == null)
            return;


        try
        {
            var id = ClienteEliminar.Id_cliente;


            var respuesta =
                await Http.DeleteAsync(
                    $"api/Clientes/{id}"
                );


            if (respuesta.IsSuccessStatusCode)
            {
                MostrarConfirmacion = false;

                ClienteEliminar = null;

                Mensaje =
                    "Cliente eliminado correctamente.";

                EsError = false;

                await CargarClientes();
            }
            else
            {
                EsError = true;

                Mensaje =
                    $"Error al eliminar el cliente. Código: {(int)respuesta.StatusCode}";
            }

        }
        catch (Exception ex)
        {
            EsError = true;

            Mensaje =
                "Error al comunicarse con la API: " + ex.Message;
        }
    }


    // =====================================================
    // PAGINACIÓN
    // =====================================================

    private void PaginaAnterior()
    {
        if (PaginaActual > 1)
        {
            PaginaActual--;
        }
    }


    private void PaginaSiguiente()
    {
        if (PaginaActual < TotalPaginas)
        {
            PaginaActual++;
        }
    }


    // =====================================================
    // MODELO PARA EL FRONT
    // =====================================================

    public class ClienteDto
    {
        public int Id_cliente { get; set; }


        [Required(ErrorMessage = "El CUI es obligatorio.")]
        public string CUI { get; set; } = string.Empty;


        [Required(ErrorMessage = "El NIT es obligatorio.")]
        public string NIT { get; set; } = string.Empty;


        [Required(ErrorMessage = "Los nombres son obligatorios.")]
        public string Nombres { get; set; } = string.Empty;


        [Required(ErrorMessage = "Los apellidos son obligatorios.")]
        public string Apellidos { get; set; } = string.Empty;


        public string? Direccion { get; set; }


        public string? Telefono { get; set; }


        [Required(ErrorMessage = "La fecha de nacimiento es obligatoria.")]
        public DateTime Fecha_Nacimiento { get; set; }
    }

}