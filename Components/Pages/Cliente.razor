@page "/clientes"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject IJSRuntime JS


<h3 class="mb-4">Gestión de Clientes</h3>

@if (cargando)
{
    <p><em>Cargando clientes...</em></p>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="MostrarModalNuevo">
        <i class="bi bi-plus-circle"></i> Nuevo
    </button>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>CUI</th>
                <th>NIT</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Dirección</th>
                <th>Teléfono</th>
                <th>Fecha Nacimiento</th>
                <th class="clientes-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (clientes == null || !clientes.Any())
            {
                <tr><td colspan="8" class="text-center">No hay clientes registrados.</td></tr>
            }
            else
            {
                @foreach (var c in clientes)
                {
                    <tr>
                        <td>@c.CUI</td>
                        <td>@c.NIT</td>
                        <td>@c.Nombres</td>
                        <td>@c.Apellidos</td>
                        <td>@c.Direccion</td>
                        <td>@c.Telefono</td>
                        <td>@(c.FechaNacimiento?.ToString("dd/MM/yyyy"))</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => MostrarModalEditar(c)">
                                Editar
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarEliminar(c)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@* ===================== MODAL CREAR / EDITAR ===================== *@
@if (mostrarModal)
{
    <div class="modal fade show d-block modal-overlay" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(esEdicion ? "Editar Cliente" : "Nuevo Cliente")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <EditForm Model="clienteActual" OnValidSubmit="Guardar" FormName="formCliente">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="modal-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">CUI</label>
                                <InputText @bind-Value="clienteActual.CUI" class="form-control" maxlength="13" />
                                <ValidationMessage For="() => clienteActual.CUI" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">NIT</label>
                                <InputText @bind-Value="clienteActual.NIT" class="form-control" maxlength="15" />
                                <ValidationMessage For="() => clienteActual.NIT" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <InputText @bind-Value="clienteActual.Nombres" class="form-control" maxlength="100" />
                                <ValidationMessage For="() => clienteActual.Nombres" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <InputText @bind-Value="clienteActual.Apellidos" class="form-control" maxlength="100" />
                                <ValidationMessage For="() => clienteActual.Apellidos" class="text-danger" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Dirección</label>
                                <InputText @bind-Value="clienteActual.Direccion" class="form-control" maxlength="255" />
                                <ValidationMessage For="() => clienteActual.Direccion" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText @bind-Value="clienteActual.Telefono" class="form-control" maxlength="20" />
                                <ValidationMessage For="() => clienteActual.Telefono" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha de Nacimiento</label>
                                <InputDate @bind-Value="clienteActual.FechaNacimiento" class="form-control" />
                                <ValidationMessage For="() => clienteActual.FechaNacimiento" class="text-danger" />
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>

                        @if (esEdicion)
                        {
                            <button type="submit" class="btn btn-primary">Actualizar</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success">Guardar</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ===================== MODAL CONFIRMAR ELIMINAR ===================== *@
@if (mostrarConfirmacion)
{
    <div class="modal fade show d-block modal-overlay" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                </div>
                <div class="modal-body">
                    ¿Seguro que deseas eliminar al cliente
                    <strong>@clienteActual.Nombres @clienteActual.Apellidos</strong>?
                    Esta acción no se puede deshacer.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => mostrarConfirmacion = false">Cancelar</button>
                    <button class="btn btn-danger" @onclick="Eliminar">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ClienteDTO>? clientes;
    private ClienteDTO clienteActual = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarConfirmacion = false;
    private bool esEdicion = false;
    private static readonly System.Text.Json.JsonSerializerOptions ApiJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    /*{
        cargando = true;
        try
        {
            Console.WriteLine($"URL base: {Http.BaseAddress}");
            Console.WriteLine($"URL solicitada: {new Uri(Http.BaseAddress!, "api/Clientes")}"); 

            clientes = await Http.GetFromJsonAsync<List<ClienteDTO>>("api/Clientes");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar: {ex.Message}");
        }
        cargando = false;
    }*/

    
{
    cargando = true;

    try
    {
        var url = new Uri(Http.BaseAddress!, "api/Clientes");

        Console.WriteLine($"URL base: {Http.BaseAddress}");
        Console.WriteLine($"URL solicitada: {url}");

        var respuesta = await Http.GetAsync(url);

        Console.WriteLine($"Código HTTP: {(int)respuesta.StatusCode}");
        Console.WriteLine($"Estado: {respuesta.StatusCode}");

        var contenido = await respuesta.Content.ReadAsStringAsync();
        Console.WriteLine($"Respuesta: {contenido}");

        respuesta.EnsureSuccessStatusCode();

        clientes = System.Text.Json.JsonSerializer.Deserialize<List<ClienteDTO>>(
            contenido,
            ApiJsonOptions);
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error: {ex}");
    }
    finally
    {
        cargando = false;
    }
}


    private void MostrarModalNuevo()
    {
        clienteActual = new ClienteDTO();
        esEdicion = false;
        mostrarModal = true;
    }

    private void MostrarModalEditar(ClienteDTO c)
    {
        clienteActual = new ClienteDTO
        {
            IdCliente = c.IdCliente,
            CUI = c.CUI,
            NIT = c.NIT,
            Nombres = c.Nombres,
            Apellidos = c.Apellidos,
            Direccion = c.Direccion,
            Telefono = c.Telefono,
            FechaNacimiento = c.FechaNacimiento
        };
        esEdicion = true;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        clienteActual = new ClienteDTO();
    }

    private async Task Guardar()
    {
        try
        {
            if (esEdicion)
            {
                var resp = await Http.PutAsJsonAsync($"api/Clientes/{clienteActual.IdCliente}", clienteActual, ApiJsonOptions);
                if (!resp.IsSuccessStatusCode)
                {
                    Console.WriteLine($"Error PUT: {resp.StatusCode}");
                }
            }
            else
            {
                var resp = await Http.PostAsJsonAsync("api/Clientes", clienteActual, ApiJsonOptions);
                if (!resp.IsSuccessStatusCode)
                {
                    Console.WriteLine($"Error POST: {resp.StatusCode}");
                }
            }

            CerrarModal();
            await CargarClientes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar: {ex.Message}");
        }
    }

    private void ConfirmarEliminar(ClienteDTO c)
    {
        clienteActual = c;
        mostrarConfirmacion = true;
    }

    private async Task Eliminar()
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/Clientes/{clienteActual.IdCliente}");
            if (!resp.IsSuccessStatusCode)
            {
                Console.WriteLine($"Error DELETE: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
        }
        mostrarConfirmacion = false;
        await CargarClientes();
    }

    // ======= DTO con DataAnnotations para validaciones Bootstrap =======
    public class ClienteDTO
    {
        [System.Text.Json.Serialization.JsonPropertyName("id_cliente")]
        public int IdCliente { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("cui")]
        [Required(ErrorMessage = "El CUI es obligatorio.")]
        [StringLength(13, MinimumLength = 13, ErrorMessage = "El CUI debe tener 13 caracteres.")]
        public string CUI { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("nit")]
        [Required(ErrorMessage = "El NIT es obligatorio.")]
        [StringLength(15, ErrorMessage = "El NIT no debe exceder 15 caracteres.")]
        public string NIT { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("nombres")]
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string Nombres { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("apellidos")]
        [Required(ErrorMessage = "El apellido es obligatorio.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string Apellidos { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("direccion")]
        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [StringLength(255, ErrorMessage = "Máximo 255 caracteres.")]
        public string Direccion { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("telefono")]
        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [StringLength(20, ErrorMessage = "Máximo 20 caracteres.")]
        [RegularExpression(@"^[0-9]+$", ErrorMessage = "Solo se permiten números.")]
        public string Telefono { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("fecha_nacimiento")]
        [Required(ErrorMessage = "La fecha de nacimiento es obligatoria.")]
        public DateTime? FechaNacimiento { get; set; }
    }
}